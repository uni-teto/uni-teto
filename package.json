    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
