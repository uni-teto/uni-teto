# Copie para .env e ajuste se necessário: cp .env.example .env

# Banco local do docker-compose
DATABASE_URL="postgresql://uniteto:uniteto@localhost:5432/uniteto?schema=public"

# SMTP do Mailpit (docker-compose). Interface: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Remetente dos e-mails (opcional; padrão: UniTeto <nao-responda@uniteto.local>)
# SMTP_FROM="UniTeto <nao-responda@seu-dominio>"
# Em produção (Mailpit não exige): SMTP_USER, SMTP_PASSWORD e SMTP_SECURE="true"

# Better Auth. Gere um segredo com: npx @better-auth/cli secret
# (ou qualquer texto aleatório com 32+ caracteres). Nunca reaproveite em produção.
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (fotos). Painel do Cloudinary → Settings → API Keys.
# Sem estas variáveis o site funciona, só o envio de fotos fica desativado.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
